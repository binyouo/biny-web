{
  "name": "biny-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Marketing site for Biny.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:pages": "pnpm build && node scripts/prepare-pages.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.1",
    "@astryxdesign/core": "0.2.0",
    "@astryxdesign/theme-neutral": "0.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "3.25.76",
    "@agentclientprotocol/sdk": "1.8.0",
    "@ai-sdk/provider": "4.0.10",
    "@ai-sdk/code-mode": "1.0.50",
    "ai": "7.0.93",
    "undici": "6.28.1",
    "@openai/agents-core": "0.3.9",
    "@ai-sdk/anthropic": "4.0.49",
    "@ai-sdk/google": "4.0.17",
    "@ai-sdk/openai": "4.0.60",
    "@ai-sdk/openai-compatible": "3.0.11",
    "@huggingface/transformers": "4.2.0",
    "best-effort-json-parser": "1.2.1",
    "sqlite-vec": "0.1.9",
    "yaml": "2.9.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "shiki": "4.4.3",
    "framer-motion": "13.2.0",
    "@floating-ui/dom": "1.8.0",
    "beautiful-mermaid": "1.1.3",
    "dompurify": "3.4.15",
    "@antv/infographic": "0.2.6",
    "@strudel/web": "1.3.0",
    "unified": "11.0.5",
    "remark-parse": "11.0.0",
    "remark-math": "6.0.0",
    "rehype-katex": "7.0.1",
    "remark-breaks": "4.0.0",
    "remark-cjk-friendly": "2.3.2",
    "remark-cjk-friendly-gfm-strikethrough": "2.3.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "morphdom": "2.7.4",
    "thinking-orbs": "0.2.0",
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0",
    "katex": "0.18.7",
    "mermaid": "11.17.2",
    "@mozilla/readability": "0.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "packageExtensions": {
      "@antv/infographic@0.2.6": {
        "dependencies": {
          "eventemitter3": "^5.0.1"
        }
      }
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "@types/node": "22.19.21",
    "esbuild": "0.28.1",
    "jsdom": "30.1.0",
    "@types/ws": "8.18.1",
    "@types/jsdom": "30.0.0"
